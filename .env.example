APP_NAME=production-reliability-platform
APP_VERSION=0.1.0
APP_ENV=local
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/reliability
ENABLE_FAULT_INJECTION=false
FAULT_ADMIN_TOKEN=replace-with-a-long-random-value
RECOVERY_SUCCESS_THRESHOLD=2
INCIDENT_PROVIDER=mock
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=replace-me
SERVICENOW_PASSWORD=replace-me

